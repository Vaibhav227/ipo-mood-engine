DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ipo_mood_engine?schema=public"

PINECONE_API_KEY=""
PINECONE_INDEX=""
PINECONE_HOST=""
# Optional. Leave blank to use Pinecone's default namespace for older vector APIs.
PINECONE_NAMESPACE=""
PINECONE_TEXT_FIELD="chunk_text"
PINECONE_UPSERT_BATCH_SIZE="50"
PINECONE_EMBED_MODEL="llama-text-embed-v2"

API_PORT="4000"
API_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://ipometrics.com,https://www.ipometrics.com"

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ipo-mood-engine/0.1 by your-reddit-username"

# Optional tuning
PIPELINE_ENABLE_REDDIT="false"
PIPELINE_MAX_NEWS_PER_IPO="10"
PIPELINE_NEWS_INCLUDE_SOURCE_SEARCH="true"
PIPELINE_NEWS_FETCH_TIMEOUT_MS="8000"
PIPELINE_MAX_REDDIT_POSTS_PER_QUERY="10"
PIPELINE_INCLUDE_REDDIT_COMMENTS="true"
SPAM_SCORE_SKIP_THRESHOLD="0.75"
