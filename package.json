{
  "name": "ipo-mood-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "ingest:reddit": "tsx apps/worker/src/commands/ingestReddit.ts",
    "ingest:news": "tsx apps/worker/src/commands/ingestNews.ts",
    "clean:text": "tsx apps/worker/src/commands/cleanText.ts",
    "embeddings:generate": "tsx apps/worker/src/commands/generateEmbeddings.ts",
    "pipeline:daily": "tsx apps/worker/src/commands/runDailyPipeline.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx packages/db/src/seed.ts"
  }
}
