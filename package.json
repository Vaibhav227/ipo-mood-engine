{
  "name": "ipo-mood-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:apply-schema": "tsx packages/db/src/applySchema.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:check": "tsx packages/db/src/checkDatabaseUrl.ts",
    "db:ping": "tsx packages/db/src/ping.ts",
    "db:ping:direct": "tsx packages/db/src/pingDirect.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "ingest:manual": "tsx apps/worker/src/commands/ingestManual.ts",
    "ingest:reddit": "tsx apps/worker/src/commands/ingestReddit.ts",
    "ingest:news": "tsx apps/worker/src/commands/ingestNews.ts",
    "clean:text": "tsx apps/worker/src/commands/cleanText.ts",
    "embeddings:generate": "tsx apps/worker/src/commands/generateEmbeddings.ts",
    "embeddings:generate:psql": "tsx apps/worker/src/commands/generateEmbeddingsPsql.ts",
    "score:mood:psql": "tsx apps/worker/src/commands/scoreMoodPsql.ts",
    "report:mood:psql": "tsx apps/worker/src/commands/reportMoodPsql.ts",
    "pipeline:daily": "tsx apps/worker/src/commands/runDailyPipeline.ts",
    "api:build": "tsc -p tsconfig.build.api.json",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:start": "node dist-api/apps/api/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx packages/db/src/seed.ts"
  }
}
